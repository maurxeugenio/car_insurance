ENV=development

# Rate calculation
AGE_RATE_PER_YEAR=0.005        # 0.5% per year of car age
VALUE_RATE_PER_10K=0.005       # 0.5% per $10,000 of car value

# Policy
COVERAGE_PERCENTAGE=1.0        # 100% coverage

# GIS (leave empty to use OpenStreetMap automatically)
GIS_MAX_ADJUSTMENT=0.02        # ±2% geographic risk adjustment
GIS_SERVICE_URL=